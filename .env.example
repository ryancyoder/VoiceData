# Anthropic API key, used by the conversational agent that manages the database
ANTHROPIC_API_KEY=

# OpenAI API key, used only for Whisper speech-to-text transcription
OPENAI_API_KEY=

# Supabase project, used by the Sales Board (/sales-board)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — server-only (never prefix with NEXT_PUBLIC).
# Server code uses this so the app keeps working after the public "allow all"
# RLS policies are removed. Keep this secret; it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Shared bearer token for the VoiceMap sync API (/api/voicemap/sync). The
# VoiceMap PWA is serverless and can't reach the locked-down database directly,
# so it syncs through these server routes, which sit OUTSIDE the password gate
# and are guarded by this token instead. Generate with `openssl rand -hex 32`
# and paste the same value into VoiceMap's Cloud Sync settings. Until this is
# set, /api/voicemap/sync returns 503.
VOICEMAP_SYNC_TOKEN=

# App password gate (see middleware.ts). APP_PASSWORD is what people type on
# the /login screen; SESSION_TOKEN is a long random secret stored in the
# session cookie and checked by the middleware. Generate SESSION_TOKEN with
# e.g. `openssl rand -hex 32`. The gate is inactive until SESSION_TOKEN is set.
APP_PASSWORD=
SESSION_TOKEN=
