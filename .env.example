# Anthropic API key, used by the conversational agent that manages the database
ANTHROPIC_API_KEY=

# OpenAI API key, used only for Whisper speech-to-text transcription
OPENAI_API_KEY=

# Supabase project, used by the Sales Board (/sales-board)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — server-only (never prefix with NEXT_PUBLIC).
# Server code uses this so the app keeps working after the public "allow all"
# RLS policies are removed. Keep this secret; it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Shared bearer token for the VoiceMap sync API (/api/voicemap/sync). The
# VoiceMap PWA is serverless and can't reach the locked-down database directly,
# so it syncs through these server routes, which sit OUTSIDE the password gate
# and are guarded by this token instead. Generate with `openssl rand -hex 32`
# and paste the same value into VoiceMap's Cloud Sync settings. Until this is
# set, /api/voicemap/sync returns 503.
VOICEMAP_SYNC_TOKEN=

# App password gate (see middleware.ts). APP_PASSWORD is what people type on
# the /login screen; SESSION_TOKEN is a long random secret stored in the
# session cookie and checked by the middleware. Generate SESSION_TOKEN with
# e.g. `openssl rand -hex 32`. The gate is inactive until SESSION_TOKEN is set.
APP_PASSWORD=
SESSION_TOKEN=

# ─── Aspire proposal search (the "Find in Aspire" button on a deal) ────────
# Aspire proposal URLs can't be derived from the proposal number, so
# /api/aspire-search drives a headless browser through Aspire's search box and
# caches the URL it lands on in the deal's `aspire_link`. See
# docs/aspire-proposal-search.md.

# Aspire's origin. Only set this if your tenant isn't on the default host.
ASPIRE_BASE_URL=https://cloud.youraspire.com

# Encrypts the stored Aspire session (cookies) before it's written to the
# app_settings table — without it the app refuses to store a session at all.
# Generate with `openssl rand -hex 32`.
ASPIRE_SESSION_SECRET=

# Where the headless Chromium comes from. Serverless hosts have no browser on
# disk, so production needs a remote one (Browserless/Browserbase and friends
# speak CDP; set ASPIRE_BROWSER_PROTOCOL=playwright for a `playwright
# run-server` endpoint). Locally, point ASPIRE_BROWSER_EXECUTABLE at an
# installed Chrome instead and leave the endpoint empty.
ASPIRE_BROWSER_WS_ENDPOINT=
ASPIRE_BROWSER_PROTOCOL=cdp
ASPIRE_BROWSER_EXECUTABLE=

# Optional: lets an expired Aspire session re-authenticate on its own instead
# of waiting for a fresh session to be pasted into /admin/aspire-session. If
# the tenant's login page is unusual, override the selectors too.
# Aspire's login form asks for four things, so email and password alone won't
# get in. ASPIRE_COMPANY_CODE is the tenant code typed on the login screen and
# is required. ASPIRE_DEVICE_NAME is what Aspire remembers this browser by;
# leave it alone unless you have a reason — a name that changes between runs
# looks like a new device each time and re-triggers device verification.
ASPIRE_USERNAME=
ASPIRE_PASSWORD=
ASPIRE_COMPANY_CODE=
ASPIRE_DEVICE_NAME=VoiceData
ASPIRE_LOGIN_USER_SELECTOR=
ASPIRE_LOGIN_PASS_SELECTOR=
ASPIRE_LOGIN_COMPANY_SELECTOR=
ASPIRE_LOGIN_DEVICE_SELECTOR=
ASPIRE_LOGIN_SUBMIT_SELECTOR=
